mpact SOT-23 package. Its low gate threshold voltage and small footprint make it a popular choice for low-voltage switching and power management applications."}],"pdfUrl":"https://datasheet.lcsc.com/datasheet/pdf/7f2d773fd4284d558538ebc799c27c6e.pdf?productCode=C82045","authenticationList":["ROHS3 认证"],"isRohsCert":true,"rohsCertType":"ROHS3","rohsCertList":[{"fileCode":"wj1690782","fileName":"安森美半导体产品_RoHS认证(英文版)_onsemi(安森美).pdf","url":"https://datasheet.lcsc.com/certification/rohs/aa23cf2005b53a1abf346f9caf1d76dd.pdf"},{"fileCode":"wj1576024","fileName":"全量通用_ROHS认证(英文版)_onsemi(安森美).pdf","url":"https://datasheet.lcsc.com/certification/rohs/09e92fbb112c0ff8254124358ae6caf5.pdf"},{"fileCode":"wj1851663","fileName":"全量通用_ROHS认证_onsemi(安森美).pdf","url":"https://datasheet.lcsc.com/certification/rohs/81002a3fab0ef8e30d18b2bb7c7965d0.pdf"},{"fileCode":"wj558315","fileName":"全量通用_ROHS认证(英文版)_onsemi(安森美).pdf","url":"https://datasheet.lcsc.com/certification/rohs/cb1881e33b779ff24903939b82837ade.pdf"}],"productDescEn":"N-Channel 50V 200mA 225mW Surface Mount SOT-23","productIntroEn":"N-Channel 50V 200mA 225mW Surface Mount SOT-23","paramVOList":[{"paramCode":"param_32500_n","paramName":"输出电容(Coss)","paramNameEn":"Output Capacitance(Coss)","paramValue":"12pF","paramValueEn":"12pF","paramValueEnForSearch":12.0,"isMain":false,"sortNumber":1,"sort":11},{"paramCode":"param_11368_nt","paramName":"输入电容(Ciss)","paramNameEn":"Ciss-Input Capacitance","paramValue":"50pF","paramValueEn":"50pF","paramValueEnForSearch":50.0,"isMain":false,"sortNumber":1,"sort":7},{"paramCode":"param_11369_n","paramName":"耗散功率(Pd)","paramNameEn":"Pd - Power Dissipation","paramValue":"225mW","paramValueEn":"225mW","paramValueEnForSearch":0.225,"isMain":true,"sortNumber":1,"sort":4},{"paramCode":"param_26782","paramName":"配置","paramNameEn":"Configuration","paramValue":"-","paramValueEn":"-","paramValueEnForSearch":-1.0,"isMain":false,"sortNumber":1,"sort":3},{"paramCode":"param_15045_s","paramName":"工作温度","pa